---
interface Props {
  total: number;
  label: string;
}
const { total, label } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
---

<div class="carousel" data-carousel role="region" aria-roledescription="carousel" aria-label={label}>
  <p class="counter mono" aria-hidden="true"><span data-counter>01</span> / {pad(total)}</p>
  <div class="viewport">
    <slot />
  </div>
  <div class="controls">
    <button type="button" data-prev aria-label={`Previous ${label.toLowerCase()} item`}>
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M13 8H3m4-4L3 8l4 4"></path></svg>
    </button>
    <button type="button" data-next aria-label={`Next ${label.toLowerCase()} item`}>
      <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
    </button>
  </div>
</div>

<style>
  .carousel {
    position: relative;
    height: 100%;
  }
  .counter {
    position: absolute;
    top: 0;
    right: 0;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--color-counter);
    z-index: 1;
  }
  .viewport {
    position: absolute;
    inset: 0;
  }
  .controls {
    position: absolute;
    left: 0;
    bottom: 0;
    display: flex;
    gap: 0.75rem;
    z-index: 1;
  }
  button {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: color-mix(in srgb, var(--color-text-primary) 45%, transparent);
    cursor: pointer;
    transition: color 0.2s;
  }
  button:hover,
  button:focus-visible {
    color: var(--color-accent);
  }
  svg path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 768px) {
    .controls {
      position: fixed;
      left: auto;
      right: calc(var(--frame) + 0.5rem);
      bottom: calc(var(--frame) + 0.25rem);
      gap: 0.25rem;
    }
  }
</style>
