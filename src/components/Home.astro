---
import { profile } from "../data/content";
---

<section data-section="home" id="home" aria-label="Home" class="section legible">
  <div class="lines">
    {profile.home.map((line) => <p data-reveal="lines">{line}</p>)}
  </div>
</section>

<style>
  /* Positioned bottom-right by the page's .section rules */
  .lines {
    max-width: 32rem;
    text-align: right;
    font-size: 0.875rem;
    line-height: 1.7;
    font-weight: 300;
    color: color-mix(in srgb, var(--color-text-primary) 70%, transparent);
  }
  @media (max-width: 768px) {
    .lines {
      text-align: left;
      font-size: 0.8rem;
    }
    .lines p + p {
      margin-top: 0.75rem;
    }
  }
</style>
