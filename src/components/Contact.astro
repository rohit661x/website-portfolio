---
import { links } from "../data/content";

const rows = [
  { label: "Email", text: links.email, href: `mailto:${links.email}` },
  { label: "GitHub", text: "rohit661x", href: links.github },
  { label: "LinkedIn", text: "RohitSuryadevara", href: links.linkedin },
];
---

<section data-section="contact" id="contact" aria-label="Contact" class="section legible">
  <div class="contact">
    <h2 class="heading" data-reveal="title">Let's build something.</h2>
    <p class="lede" data-reveal="lines">Email is the fastest way to reach me.</p>
    <ul class="rows mono">
      {
        rows.map((row) => (
          <li data-reveal="item">
            <span class="label">{row.label}</span>
            <a
              class="link"
              href={row.href}
              {...(row.href.startsWith("http") ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              {row.text} →
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .contact {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-left: 34%;
  }
  .heading {
    font-size: clamp(2.25rem, 4.6vw, 4.25rem);
    line-height: 1.05;
    font-weight: 300;
    letter-spacing: -0.015em;
  }
  .lede {
    margin-top: 1.25rem;
    font-size: 0.875rem;
    font-weight: 300;
    color: color-mix(in srgb, var(--color-text-primary) 60%, transparent);
  }
  .rows {
    margin-top: 2.75rem;
    display: grid;
    gap: 0.4rem;
  }
  .rows li {
    display: grid;
    grid-template-columns: 6rem 1fr;
    align-items: center;
    min-height: 32px;
  }
  .label {
    font-size: 0.72rem;
    color: color-mix(in srgb, var(--color-text-primary) 40%, transparent);
  }
  .link {
    font-size: 0.85rem;
    word-break: break-all;
  }

  @media (max-width: 1100px) {
    .contact {
      padding-left: 18%;
    }
  }
  @media (max-width: 768px) {
    .contact {
      height: auto;
      padding: 2rem 0 1rem;
    }
    .rows li {
      grid-template-columns: 1fr;
      min-height: 44px;
      align-content: center;
    }
    .link {
      font-size: 0.72rem;
    }
  }
</style>
