---
import { profile } from "../data/content";

const nav = ["home", "work", "projects", "about", "contact"];
---

<nav id="sidebar" aria-label="Primary" class="legible">
  <div class="identity">
    <h1 class="name">{profile.name}</h1>
    <p class="title-slot">
      <span data-title-cycler data-titles={JSON.stringify(profile.titles)}>{profile.titles[0]}</span>
    </p>
  </div>
  <ul class="links">
    {
      nav.map((id) => (
        <li>
          <a href={`#${id}`} data-nav={id}>
            {id}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  #sidebar {
    position: fixed;
    top: calc(var(--frame) - 0.75rem);
    left: var(--frame);
    bottom: var(--frame);
    z-index: 10;
    padding: 2.5rem 2rem 0;
    display: flex;
    flex-direction: column;
    pointer-events: none;
  }
  .identity {
    white-space: nowrap;
  }
  .name {
    font-size: 3rem;
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  /* No clipping: the title drifts visibly as it fades (see titleCycler.ts) */
  .title-slot {
    margin-top: 0.9rem;
    font-size: 1.05rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-text-primary) 55%, transparent);
  }
  .title-slot span {
    display: inline-block;
  }
  .links {
    margin-top: 3rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    pointer-events: auto;
    width: fit-content;
  }
  .links a {
    font-size: 0.875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    transition: color 0.2s;
  }
  .links a:hover,
  .links a:focus-visible {
    color: var(--color-accent-soft);
  }
  .links a.is-active {
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    #sidebar {
      top: var(--frame);
      width: 35%;
      padding: 1.25rem 0.75rem 0;
    }
    /* Name runs across the top; content starts below it (see #content-area) */
    .identity {
      width: calc(100vw - 2 * var(--frame) - 1.5rem);
    }
    .name {
      font-size: 1.6rem;
      line-height: 1.05;
    }
    .title-slot {
      margin-top: 0.5rem;
      font-size: 0.66rem;
      letter-spacing: 0.08em;
    }
    .links {
      margin-top: 1.75rem;
      gap: 0;
    }
    .links a {
      display: flex;
      align-items: center;
      min-height: 44px;
      font-size: 0.75rem;
    }
  }
</style>
